---
import RoleCards from './RoleCards.astro';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  pt: {
    lede: 'Duas empresas que eu toco como sócio, dois contratos como prestador de serviço, um estágio encerrado, sete anos de freelance em 3D — e, antes de tudo isso, cinco anos fazendo jogos. Abaixo, o que cada vínculo produziu.',
  },
  en: {
    lede: 'Two companies I run as a partner, two contract engagements, one internship now finished, seven years of freelance 3D work — and, before any of it, five years making games. Below, what each one produced.',
  },
}[lang];

---

<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
  <header class="max-w-3xl">
    <p class="rule text-ref">{t('section.work')}</p>
    <h1 class="mt-5 text-section">{t('nav.work')}</h1>
    <p class="mt-7 text-lg text-dim sm:text-xl">{copy.lede}</p>
  </header>

  <RoleCards lang={lang} showRelated />
</div>
