---
import { useTranslations, localizePath, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;

const elsewhere = [
  { href: 'https://github.com/pedrobraiti', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/pedrobraiti', label: 'LinkedIn' },
  { href: 'https://www.artstation.com/pedrotyppe', label: 'ArtStation' },
];

/* O Instagram pessoal saiu a pedido do Pedro — ele não usa. Ficam os das empresas. */
const companies = [
  { href: 'https://www.instagram.com/darkmarlin.dev', label: 'Dark Marlin' },
  { href: 'https://www.instagram.com/octusforge', label: 'Octus Forge' },
];
---

<footer id="contato" class="border-t border-line bg-surface/40">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr]">
      <div>
        <h2 class="text-section">{t('contact.title')}</h2>
        <p class="mt-5 max-w-md text-lg text-dim">{t('contact.lede')}</p>

        <!--
          Dois canais, e o WhatsApp primeiro: é o que um cliente brasileiro abre.
          O número já é público no PDF do currículo servido neste mesmo domínio, então
          o link não expõe nada que já não estivesse exposto.
        -->
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://wa.me/5541999591221"
            rel="noopener"
            target="_blank"
            class="border border-measure bg-measure px-6 py-3 font-mono text-sm text-page transition-colors hover:bg-transparent hover:text-measure"
          >
            WhatsApp ↗
          </a>
          <a
            href="mailto:braitipedro17@gmail.com"
            class="border border-line px-6 py-3 font-mono text-sm text-ink transition-colors hover:border-measure hover:text-measure"
            translate="no"
          >
            braitipedro17@gmail.com
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8">
        <div class="flex flex-col gap-3">
          <p class="rule text-ref">{lang === 'pt' ? 'Curitiba, Brasil' : 'Curitiba, Brazil'}</p>
          <ul class="mt-2 flex flex-col gap-2">
            {
              elsewhere.map((item) => (
                <li>
                  <a
                    href={item.href}
                    rel="noopener"
                    target="_blank"
                    class="font-mono text-sm text-dim transition-colors hover:text-measure"
                    translate="no"
                  >
                    {item.label} ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col gap-3">
          <p class="rule text-ref">{t('companies.eyebrow')}</p>
          <ul class="mt-2 flex flex-col gap-2">
            {
              companies.map((item) => (
                <li>
                  <a
                    href={item.href}
                    rel="noopener"
                    target="_blank"
                    class="font-mono text-sm text-dim transition-colors hover:text-measure"
                    translate="no"
                  >
                    {item.label} ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-2 border-t border-line pt-6 text-xs text-dim sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono">© {year} Pedro Alessandrini Braiti</p>
      <a
        href="https://github.com/pedrobraiti/landing-page"
        rel="noopener"
        target="_blank"
        class="font-mono transition-colors hover:text-measure"
      >
        {t('footer.built')}
      </a>
    </div>
  </div>
</footer>
