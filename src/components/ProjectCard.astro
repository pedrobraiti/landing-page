---
import { Image } from 'astro:assets';
import { localizePath, familyLabels, type Locale } from '../lib/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Locale;
  featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const { title, slug, summary, measure, family, status, cover, gallery } = project.data;

/*
  Projeto sem capa cai na primeira imagem da galeria — é o caso da Emais, cujo app é
  feito para celular e cuja captura de desktop era a parte feia. `object-top` porque
  numa captura de celular recortada em paisagem o que interessa está no alto da tela.
*/
const preview = cover ?? gallery[0]?.src;
const href = localizePath(`/projetos/${slug}`, lang);
---

<article
  class:list={[
    'group relative flex flex-col border border-line bg-surface/50 transition-colors duration-300 hover:border-measure/60',
    featured && 'md:flex-row',
  ]}
>
  {
    preview && (
      <div class:list={['overflow-hidden border-line', featured ? 'md:w-1/2 md:border-r border-b md:border-b-0' : 'border-b']}>
        <Image
          src={preview}
          alt={title}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          {/*
            `max-h-96` só no caso da galeria: a imagem é uma captura de celular, e uma
            proporção 9:16 com `h-full` puxa a altura da linha inteira do cartão — o da
            Emais chegou a 1.400px de alto. `object-top` porque o que identifica o app
            está no alto da tela.
          */}
          class:list={[
            'h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]',
            !cover && 'max-h-96 object-top',
          ]}
          loading="lazy"
        />
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col p-6 sm:p-8', featured && 'md:justify-center']}>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span class="rule text-ref">{familyLabels[lang][family]}</span>
      <span class="rule text-dim">
        <span aria-hidden="true">·&nbsp;</span>{status}
      </span>
    </div>

    <h3 class:list={['mt-4 tracking-tight', featured ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
      <a href={href} class="after:absolute after:inset-0 hover:text-measure">
        {title}
      </a>
    </h3>

    <p class="mt-4 flex-1 text-pretty text-dim">{summary}</p>

    <!--
      A medida entra como nota de rodapé, não como manchete. Um número grande e
      dourado num cartão vira vaidade; o valor está na frase que explica o que ele
      provou. O número em tamanho de manchete fica só na página do projeto, onde
      cabe a condição inteira ao lado dele.
    -->
    <p class="mt-6 border-t border-line pt-5 text-sm leading-relaxed text-dim">
      <span class="font-mono tabular-nums text-measure" translate="no">{measure.value}</span>
      <span> — {measure.label}</span>
    </p>
  </div>
</article>
