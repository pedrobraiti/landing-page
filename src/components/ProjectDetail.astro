---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Measure from './Measure.astro';
import { useTranslations, localizePath, familyLabels, type Locale } from '../lib/i18n';
import { linkOrgsInText } from '../lib/orgLinks.mjs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'> | undefined;
  lang: Locale;
}

const { project, next, lang } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  summary,
  measure,
  family,
  role,
  context,
  period,
  status,
  stack,
  links,
  cover,
  coverAlt,
  coverCardOnly,
  gallery,
  video,
} = project.data;
const { Content } = await render(project);

/*
  Três ou mais imagens na galeria só acontece quando são capturas de tela de celular.
  Elas ganham canto arredondado e legenda solta; o par antes/depois continua com a
  legenda encaixada na moldura, que ali funciona como plaqueta de figura técnica.
*/
const isPhoneShots = gallery.length >= 3;

/* Capa só de card (a da Emais) não entra na abertura: a galeria já mostra as telas. */
const hasHeroCover = Boolean(cover) && !coverCardOnly;

/*
  `context` costuma nomear a empresa ("Cliente da Dark Marlin"), e o Pedro pediu que
  toda citação de empresa fosse clicável. No corpo do texto o link está escrito no
  próprio Markdown; aqui é campo de frontmatter, então sai como HTML montado.
*/
const facts = [
  { label: t('project.role'), value: role },
  { label: t('project.context'), value: linkOrgsInText(context), html: true },
  { label: t('project.period'), value: period },
  { label: t('project.status'), value: status },
];
---

<article>
  <header class="relative overflow-hidden border-b border-line">
    <div class="grid-paper pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    </div>
    <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-20">
      <a
        href={localizePath('/projetos', lang)}
        class="rule inline-block transition-colors hover:text-measure"
      >
        ← {t('project.back')}
      </a>

      <p class="rule mt-10 text-ref">{familyLabels[lang][family]}</p>
      <h1 class="mt-4 max-w-4xl text-section">{title}</h1>
      <p class="mt-6 max-w-2xl text-xl text-dim">{summary}</p>
    </div>
  </header>

  {/*
    A abertura do case é a **prova visual ao lado da leitura**, não a ficha de
    metadados. Antes o leitor batia numa tabela de Papel/Contexto/Período/Situação
    antes de ver uma linha do trabalho, e o case abria com cara de currículo. Papel e
    contexto continuam ali — em uma tira discreta, logo abaixo, onde quem procura
    encontra e quem não procura não tropeça.
  */}
  <div class="border-b border-line bg-surface/50">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <div
        class:list={
          hasHeroCover
            ? 'grid gap-px bg-line lg:grid-cols-[1.35fr_1fr]'
            : 'max-w-3xl'
        }
      >
        {
          hasHeroCover && (
            /*
              `contain` e não `cover`: quase todas as capas são capturas de interface,
              e recortar uma tela esconde exatamente o que ela deveria provar.
            */
            <div class="grid-paper flex items-center justify-center bg-page p-5 sm:p-8">
              <Image
                src={cover}
                alt={coverAlt ?? title}
                widths={[640, 1024, 1600]}
                sizes="(min-width: 1024px) 56rem, 100vw"
                class="max-h-[58vh] w-full object-contain"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }

        <Measure {...measure} lang={lang} />
      </div>

      <dl class="mt-8 flex flex-wrap items-baseline gap-x-8 gap-y-3">
        {
          facts.map((fact) => (
            <div class="flex min-w-0 flex-wrap items-baseline gap-x-2">
              <dt class="rule text-ref">{fact.label}</dt>
              {fact.html ? (
                <dd class="font-mono text-xs text-dim sm:text-sm" set:html={fact.value} />
              ) : (
                <dd class="font-mono text-xs text-dim sm:text-sm">{fact.value}</dd>
              )}
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  {
    (gallery.length > 0 || video) && (
      <div class="border-b border-line bg-surface/40">
        <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
          {gallery.length > 0 && (
            /*
              Par antes/depois fica em duas colunas. A partir de três, são capturas de
              tela de celular: quatro na largura no desktop, e 2×2 no celular — nunca
              tudo numa fileira só, senão cada uma vira uma tira ilegível de 90px.
            */
            <div
              class:list={[
                'grid gap-4 sm:gap-5',
                isPhoneShots ? 'grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2',
              ]}
            >
              {gallery.map((shot) => (
                <figure>
                  {/*
                    Captura de celular ganha canto arredondado e a legenda **solta**, fora
                    da moldura. Com a legenda colada num retângulo contínuo, ela lia como
                    parte da interface do aplicativo — a imagem parecia esticada. Aqui o
                    quadro é o aparelho e a legenda é anotação de fora.
                  */}
                  <div
                    class:list={[
                      'overflow-hidden border border-line bg-page',
                      isPhoneShots && 'rounded-[1.25rem] sm:rounded-3xl',
                    ]}
                  >
                    <Image
                      src={shot.src}
                      alt={shot.caption}
                      widths={[420, 760]}
                      sizes="(min-width: 1024px) 17rem, 45vw"
                      class="w-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  {isPhoneShots ? (
                    <figcaption class="mt-3 font-mono text-xs leading-relaxed text-dim">
                      {shot.caption}
                    </figcaption>
                  ) : (
                    <figcaption class="rule border-x border-b border-line px-4 py-3 text-dim">
                      {shot.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}

          {video && (
            /*
              `preload="none"` porque o arquivo tem alguns megabytes e quase todo
              mundo que abre a página não vai dar play. O pôster é uma imagem de
              90 KB e segura a primeira impressão sozinho.
            */
            <figure class:list={['border border-line bg-page', gallery.length > 0 && 'mt-5']}>
              <video
                controls
                playsinline
                preload="none"
                poster={video.poster}
                class="w-full"
                aria-label={video.caption}
              >
                <source src={video.src} type="video/mp4" />
              </video>
              <figcaption class="rule border-t border-line px-4 py-3 text-dim">
                {video.caption}
              </figcaption>
            </figure>
          )}
        </div>
      </div>
    )
  }

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
      <div
        class="prose-invert max-w-[56ch] text-lg leading-relaxed [&_h2]:mt-12 [&_h2]:mb-5 [&_h2]:text-2xl [&_h2]:sm:text-3xl [&_p]:mb-6 [&_strong]:text-measure [&_strong]:font-semibold [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-4 [&_a]:decoration-current/45 [&_a:hover]:decoration-current"
      >
        <Content />
      </div>

      <aside class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
        <div>
          <p class="rule text-ref">{t('project.stack')}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              stack.map((item) => (
                <li
                  class="border border-line px-2.5 py-1 font-mono text-xs text-dim"
                  translate="no"
                >
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        {
          links.length > 0 && (
            <ul class="flex flex-col gap-2 border-t border-line pt-6">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel="noopener"
                    target="_blank"
                    class="font-mono text-sm text-ref transition-colors hover:text-measure"
                  >
                    {link.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </div>
  </div>

  {
    next && (
      <nav class="border-t border-line bg-surface/40">
        <a
          href={localizePath(`/projetos/${next.data.slug}`, lang)}
          class="group mx-auto flex max-w-6xl flex-col gap-2 px-5 py-14 sm:px-8"
        >
          <span class="rule text-ref">{t('project.next')}</span>
          <span class="font-display text-3xl font-extrabold tracking-tight transition-colors group-hover:text-measure sm:text-4xl">
            {next.data.title} →
          </span>
        </a>
      </nav>
    )
  }
</article>
