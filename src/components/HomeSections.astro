---
import { Image } from 'astro:assets';
import ProjectCard from './ProjectCard.astro';
import RoleCards from './RoleCards.astro';
import Wireframe from './Wireframe.astro';
import Skills from './Skills.astro';
import { useTranslations, localizePath, type Locale } from '../lib/i18n';
import { getFeatured, getProjects } from '../lib/content';
import cavalheiro from '../assets/3d/cavalheiro4.png';
import general from '../assets/3d/general.png';
import cachorro from '../assets/3d/cachorro-humanoide.png';
import beyonce from '../assets/3d/beyonce.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const featured = await getFeatured(lang);
const research = (await getProjects(lang)).filter(
  (p) => p.data.family === 'pesquisa' && p.data.tier === 2
);

const pieces = [
  { src: cavalheiro, pt: 'Cavalheiro', en: 'Gentleman' },
  { src: general, pt: 'General', en: 'General' },
  { src: cachorro, pt: 'Cão humanoide', en: 'Humanoid dog' },
  { src: beyonce, pt: 'Retrato', en: 'Portrait' },
];

const artstation = {
  pt: 'Ver o portfólio no ArtStation',
  en: 'See the ArtStation portfolio',
}[lang];
---

{/*
  Capacidades antes de projeto. Quem chega aqui por indicação de evento quer saber o
  que ele resolve, e só depois quais foram os casos — esta seção vivia enterrada no
  meio do Sobre, a sete telas de rolagem no celular.
*/}
<Skills lang={lang} variant="band" />

<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-28">
  <header class="max-w-3xl">
    <p class="rule text-ref">{t('section.selected')}</p>
    <h2 class="mt-5 text-section">{t('section.selected.lede')}</h2>
  </header>

  <div class="mt-14 grid gap-px border border-line bg-line lg:grid-cols-2">
    {
      featured.map((project, index) => {
        /* Ímpar no fim ocupa a linha inteira, para não sobrar meia fileira vazia. */
        const fillsRow =
          index === 0 || (featured.length % 2 === 0 && index === featured.length - 1);
        /*
          No celular a home mostra três casos e manda o resto para /projetos, que já
          tem os dezessete. Não é conteúdo apagado: é dobra. A grade inteira só
          cabia em quase cinco telas de rolagem, e o contato ficava atrás dela.
        */
        return (
          <div class:list={[index >= 3 ? 'hidden lg:flex' : 'flex', fillsRow && 'lg:col-span-2']}>
            <ProjectCard
              project={project}
              lang={lang}
              featured={fillsRow}
              tone={index % 2 === 0 ? 'dark' : 'light'}
            />
          </div>
        );
      })
    }
  </div>

  {
    featured.length > 3 && (
      <a
        href={localizePath('/projetos', lang)}
        class="mt-10 inline-block border border-line px-6 py-3 font-mono text-sm transition-colors hover:border-measure hover:text-measure lg:hidden"
      >
        {t('home.fold.projects')} →
      </a>
    )
  }
</section>

<section class="border-y border-line bg-surface/30">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-28">
    <header class="max-w-3xl">
      <p class="rule text-ref">{t('section.timeline')}</p>
      <h2 class="mt-5 text-section">{t('section.timeline.lede')}</h2>
    </header>

    <RoleCards lang={lang} />

    <a
      href={localizePath('/trabalho', lang)}
      class="mt-12 inline-block border border-line px-6 py-3 font-mono text-sm transition-colors hover:border-measure hover:text-measure"
    >
      {t('timeline.cta')} →
    </a>
  </div>
</section>

{
  research.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-28">
      <header class="max-w-3xl">
        <p class="rule text-ref">{t('section.research')}</p>
        <h2 class="mt-5 text-section">{t('section.research.lede')}</h2>
      </header>
      <div class="mt-14 grid gap-px border border-line bg-line lg:grid-cols-2">
        {research.map((project, index) => {
          const fillsRow =
            research.length % 2 === 1 && index === research.length - 1;
          return (
            <div class:list={[index >= 1 ? 'hidden lg:flex' : 'flex', fillsRow && 'lg:col-span-2']}>
              <ProjectCard
              project={project}
              lang={lang}
              featured={fillsRow}
              tone={index % 2 === 0 ? 'dark' : 'light'}
            />
            </div>
          );
        })}
      </div>

      {research.length > 1 && (
        <a
          href={localizePath('/projetos', lang)}
          class="mt-10 inline-block border border-line px-6 py-3 font-mono text-sm transition-colors hover:border-measure hover:text-measure lg:hidden"
        >
          {t('home.fold.research')} →
        </a>
      )}
    </section>
  )
}

<section class="border-t border-line bg-surface/30">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-28">
    <!--
      O cubo fica ao lado do título, não dentro da grade. Na grade ele virava a
      quarta peça do portfólio e perdia feio para três esculturas de verdade; aqui
      ele é o que é — o desenho de arame que antecede tudo o que está abaixo.
    -->
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-8">
      <header class="max-w-2xl">
        <p class="rule text-ref">{t('section.3d')}</p>
        <h2 class="mt-5 text-section">{t('section.3d.lede')}</h2>
      </header>

      <Wireframe size="min(11rem, 30vw)" class="mx-auto shrink-0 sm:mx-0" />
    </div>

    <div class="mt-14 grid grid-cols-2 gap-px border border-line bg-line lg:grid-cols-4">
      {
        pieces.map((piece) => (
          <figure class="group overflow-hidden bg-page">
            <Image
              src={piece.src}
              alt={piece[lang]}
              widths={[320, 560]}
              sizes="(min-width: 1024px) 25vw, 50vw"
              class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <figcaption class="rule border-t border-line px-4 py-3 text-dim">
              {piece[lang]}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={localizePath('/3d', lang)}
        class="border border-measure px-6 py-3 font-mono text-sm text-measure transition-colors hover:bg-measure hover:text-page"
      >
        {t('nav.3d')} →
      </a>
      <a
        href="https://www.artstation.com/pedrotyppe"
        rel="noopener"
        target="_blank"
        class="border border-line px-6 py-3 font-mono text-sm transition-colors hover:border-measure hover:text-measure"
      >
        {artstation} ↗
      </a>
    </div>
  </div>
</section>
