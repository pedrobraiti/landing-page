---
/*
  O eixo do tempo. Cada barra é um vínculo; as que estão em curso encostam todas na
  borda direita, que é o presente. A sobreposição não é um defeito da diagramação —
  é o dado: hoje são quatro frentes ao mesmo tempo.

  O texto de cada linha (organização, papel, período) carrega a informação inteira.
  As barras são a leitura rápida, e por isso saem da árvore de acessibilidade.
*/
import { useTranslations, type Locale } from '../lib/i18n';
import { getRoles, formatPeriod } from '../lib/content';
import { buildTimeline } from '../lib/timeline';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const nowLabel = lang === 'pt' ? 'hoje' : 'now';
const { bars, ticks } = buildTimeline(await getRoles(lang), nowLabel);
---

<div class="mt-12">
  <div class="relative">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      {
        ticks.map((tick) => (
          <span
            class:list={['absolute inset-y-0 w-px', tick.isNow ? 'bg-measure/40' : 'bg-line/70']}
            style={{ left: `${tick.leftPercent}%` }}
          />
        ))
      }
    </div>

    <ol class="relative flex flex-col gap-6 sm:gap-7">
      {
        bars.map(({ role, leftPercent, widthPercent }, index) => (
          <li class="group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <p class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
                <span class="font-display text-lg font-bold tracking-tight" translate="no">
                  {role.data.org}
                </span>
                <span class="rule text-dim">{role.data.relation}</span>
              </p>
              <p class="rule tabular-nums text-dim">
                {formatPeriod(role.data.start, role.data.end, role.data.current, lang)}
              </p>
            </div>

            <div class="mt-2 h-2.5 w-full bg-line/40" aria-hidden="true">
              <div
                data-timeline-bar
                class:list={[
                  'h-full group-hover:opacity-80',
                  role.data.current ? 'bg-measure' : 'bg-ref/45',
                ]}
                style={{
                  marginLeft: `${leftPercent}%`,
                  width: `${widthPercent}%`,
                  '--bar-index': index,
                }}
              />
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="relative mt-3 h-5" aria-hidden="true">
    {
      ticks.map((tick) => (
        <span
          class:list={[
            'absolute top-0 font-mono text-[0.6875rem] tracking-widest tabular-nums',
            tick.isNow ? 'right-0 text-measure' : 'text-dim',
          ]}
          style={tick.isNow ? undefined : { left: `${tick.leftPercent}%` }}
        >
          {tick.label}
        </span>
      ))
    }
  </div>

  <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
    <span class="flex items-center gap-2">
      <span class="h-2.5 w-6 bg-measure" aria-hidden="true"></span>
      <span class="rule text-dim">{t('timeline.legend.current')}</span>
    </span>
    <span class="flex items-center gap-2">
      <span class="h-2.5 w-6 bg-ref/45" aria-hidden="true"></span>
      <span class="rule text-dim">{t('timeline.legend.past')}</span>
    </span>
  </p>
</div>

<style>
  /*
    O estado escrito no HTML é a barra INTEIRA. Encolher é o que o script faz, e só
    se ele rodar. Assim, se o JavaScript falhar, for bloqueado ou o navegador for
    antigo, o gráfico aparece completo — nunca vazio. A primeira tentativa aqui foi
    com `animation-timeline: view()`, que deixou as sete barras presas em `scaleX(0)`
    depois que a seção saía da tela. Medido, não suposto.
  */
  [data-timeline-bar] {
    transform-origin: left center;
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease;
    transition-delay: calc(var(--bar-index) * 70ms);
  }

  [data-timeline-bar].is-collapsed {
    transform: scaleX(0);
    transition: none;
  }
</style>

<script>
  const bars = document.querySelectorAll<HTMLElement>('[data-timeline-bar]');
  const stillPrefers = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bars.length > 0 && !stillPrefers && 'IntersectionObserver' in window) {
    bars.forEach((bar) => bar.classList.add('is-collapsed'));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.remove('is-collapsed');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.5 }
    );

    bars.forEach((bar) => observer.observe(bar));
  }
</script>
