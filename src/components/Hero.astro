---
import { Image } from 'astro:assets';
import { useTranslations, localizePath, type Locale } from '../lib/i18n';
import pedro from '../assets/pedro.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const headline = {
  pt: { lead: 'Construo sistemas que rodam', accent: 'sozinhos.' },
  en: { lead: 'I build systems that run', accent: 'on their own.' },
}[lang];
---

<section class="relative overflow-hidden border-b border-line">
  <div class="grid-paper pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-b from-transparent to-page"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-14 sm:px-8 sm:pt-20 sm:pb-20">
    <div class="grid items-end gap-9 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <!--
        No celular o retrato vem primeiro e pequeno: quem abre o site já conhece o
        Pedro pessoalmente, e o rosto é o que confirma que chegou no lugar certo.
        No desktop ele vira o retrato grande da coluna da direita.
      -->
      <figure class="order-first min-w-0 lg:order-last">
        <div class="relative w-24 border border-line bg-surface sm:w-28 lg:w-full lg:max-w-sm">
          <span class="absolute -top-px left-5 h-px w-14 bg-measure" aria-hidden="true"></span>
          <Image
            src={pedro}
            alt="Pedro Braiti"
            widths={[224, 640]}
            sizes="(min-width: 1024px) 24rem, 7rem"
            class="w-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="rule mt-3 hidden text-dim lg:block">{t('hero.caption')}</figcaption>
      </figure>

      <div class="min-w-0">
        <p class="rule text-ref">{t('hero.role')}</p>

        <h1 class="mt-6 text-hero">
          {headline.lead}<br /><span class="text-measure">{headline.accent}</span>
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-dim sm:text-xl">
          {t('hero.lede')}
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={localizePath('/projetos', lang)}
            class="border border-measure bg-measure px-6 py-3 font-mono text-sm text-page transition-colors hover:bg-transparent hover:text-measure"
          >
            {t('hero.cta.projects')}
          </a>
          <a
            href="#contato"
            class="border border-line px-6 py-3 font-mono text-sm text-ink transition-colors hover:border-measure hover:text-measure"
          >
            {t('hero.cta.contact')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
